<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aether 설치본의 LaunchAgent. 개인 운영 맥의 com.aether.backend와 라벨이 달라 서로 겹치지 않는다.
  ⚠️ __APP__(프로그램 폴더)·__HOME__(사용자 홈)·__TMP__(임시 폴더)은 빈칸 표시다. 패키지의 postinstall이 설치 때 채운다.
  ⚠️ 시크릿 금지. JWT 시크릿은 설정 폴더의 .env에 있고 서버(start.ts)가 직접 읽는다.
  ⚠️ PATH는 셸 확장이 안 되므로 절대경로로 풀어 쓴다. 일반 사용자 위치만 넣었다. Claude·Codex·Grok은 PATH에서 찾고, Claude와 Grok은 어댑터가 자기 기본 설치 위치도 직접 찾는다.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aether.app</string>

  <key>ProgramArguments</key>
  <array>
    <string>__APP__/node/bin/node</string>
    <string>__APP__/server/index.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__APP__/server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <!-- 자동 실행 장치 아래에서 도는 설치본에서만 앱 안 업데이트를 켠다. -->
    <key>AETHER_SUPERVISED</key>
    <string>1</string>
    <!-- 같은 계정의 개인 운영 서버와 임시 폴더를 나눈다(서버가 부팅 때 임시 폴더의 자기 배경 작업 폴더를 청소한다). -->
    <key>TMPDIR</key>
    <string>__TMP__</string>
  </dict>

  <!-- 정상 종료(코드 0)는 존중하고, 0이 아닌 종료는 다시 띄운다. 재시작 API와 첫 설정 저장이 코드 1로 끝나는 것을 이용한다. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ExitTimeOut</key>
  <integer>25</integer>
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- 서버가 데이터 폴더의 logs에 자체 로그를 돌려 쓴다. 실패 기록은 설정 폴더의 start.log에 남는다. -->
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
