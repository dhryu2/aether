#!/bin/bash
# 설치 직전(재설치 포함): 실행 중인 서버를 멈추고 이전 프로그램 폴더를 이름으로 지운다. 설정·데이터는 건드리지 않는다.
set -u
. "$(dirname "$0")/lib.sh"

stop_service

# 이전 Aether 설치가 있을 때만 지운다(server/index.mjs가 표시). 오래된 파일이 새 버전에 섞이지 않게 한다.
if [ -f "$APP/server/index.mjs" ]; then
  for d in bin node server web; do rm -rf "${APP:?}/$d"; done
fi
exit 0
