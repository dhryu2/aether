{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.1.0",
  "identifier": "app.aether.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:8787",
    "devUrl": "http://127.0.0.1:8787"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Aether",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "icon": ["icons/icon.png", "icons/128x128.png", "icons/32x32.png", "icons/icon.ico"]
  },
  "plugins": {}
}
