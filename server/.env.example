# Aether 백엔드 환경변수 예시 (실제 값은 .env에 — gitignore됨, 시크릿 평문 금지)
# 모두 선택사항. 미설정 시 config.ts 기본값 사용.
# 주입: launchd plist EnvironmentVariables 또는 shell. 비밀이 아닌 일반 설정은 JSON 설정 파일로도 줄 수 있다(아래).
# 우선순위: 환경변수 > 설정 파일 > 기본값.

# ── 설정 파일(선택) ──
# AETHER_CONFIG=                              # JSON 설정 파일 경로. 키 이름은 config.ts 필드 이름 그대로(예: {"port": 9001}). 비밀은 넣을 수 없다(부팅 거부). 고치면 재시작

# ── 기본 ──
# PORT=8787
# AETHER_HOST=127.0.0.1                       # 바인드 호스트(기본 루프백). 원격은 tailscale serve 또는 tailscale IP 명시
# AETHER_PROJECT_ROOT=~/projects              # 새 세션 작업 폴더를 비웠을 때 쓰는 기본 폴더(기본=실행 유저 홈). 쓸 수 있는 폴더를 제한하지 않는다. `~` 허용
# AETHER_DATA_DIR=                            # 이벤트/메타 영속 위치(기본=server/data)
# AETHER_ERROR_DIR=                           # 오류 기록 폴더(기본=<데이터폴더>/errors, 모든 OS 동일)
# AETHER_BACKUP_DIR=                          # DB 백업 폴더(기본=<데이터폴더>/backups)
# AETHER_BACKUP_KEEP=7                          # 남겨 둘 수동 백업 개수(복원 전 백업은 지우지 않음)
# AETHER_WORKTREE_DIR=                        # 격리 작업 복사본 폴더(기본=~/.aether/worktrees)
# AETHER_MODEL=haiku                          # 개발 기본 모델(쿼터 절약)
# AETHER_BUFFER_CAP=2000                      # in-memory 이벤트 버퍼 상한
# AETHER_BUFFER_MAX_BYTES=16777216            # 같은 버퍼의 바이트 상한(16MB)

# ── Phase 2 하드닝 ──
# AETHER_HELMET=1                             # 보안 헤더(기본 on; 0으로 끔)
# AETHER_COMPRESSION=0                        # 응답 압축(기본 on, 끄려면 0; SSE는 자동 제외)
# AETHER_BODY_LIMIT=256kb                     # JSON body 크기 제한
# AETHER_SERVE_STATIC=1                       # web/dist 단일포트 서빙(기본 on, 부재 시 skip)
# AETHER_WEB_DIST=                            # 빌드 프론트 경로(기본=web/dist)
# AETHER_PARTIAL=0                            # 토큰 단위 스트리밍(기본 off)

# ── Claude 구독 OAuth 원격 재인증(중계) ──
# AETHER_ENABLE_PROVIDER_RELOGIN=1            # 폰에서 원격 재로그인 기능(기본 on; 0으로 끄면 로그인 시작이 403)
#                                             구 이름 AETHER_ENABLE_CLAUDE_RELOGIN도 계속 읽는다(둘 중 하나라도 0이면 꺼짐).
# AETHER_CLAUDE_BIN=                          # claude CLI 절대경로 override(기본: which→~/.local/bin/claude 자동해석)

# ── Phase 3 인증 (기본 off) ──
# AETHER_AUTH_MODE=off                        # off | tailscale | password
# AETHER_ALLOWED_LOGINS=user@example.com      # tailscale 모드 허용 login(콤마구분, 비면 검증된 신원 누구나)
# AETHER_TAILSCALE_CLI=                       # tailscale 실행 파일 경로. 비우면 PATH와 알려진 설치 위치(맥 앱, 윈도우 Program Files)에서 자동 탐색
# AETHER_BCRYPT_COST=12
# password 모드 로그인은 JSON body에 token(쿠키와 같은 JWT)도 준다. Bearer Authorization으로도 같은 문을 쓴다.
#
# ── 시크릿 (password 모드에서만 필요. 절대 커밋 금지 — .env에만) ──
# AETHER_JWT_SECRET=                          # 충분히 긴 랜덤 문자열 (예: openssl rand -base64 48)
# AETHER_PASSWORD_HASH=                       # bcrypt 해시. 생성: npm run hash:pw (프롬프트에 비번 입력 → 출력 붙여넣기)

# ── 배경 작업(기억 자동 추출·메모리 정리·스킬 생성·검색 요약) ──
# 이 넷은 대화 세션과 별개로 도는 짧은 작업이라 가장 싼 모델이면 충분하다.
# 비워 두면 서버가 알아서 정한다 — 계정에서 실제로 쓸 수 있는 모델 목록을 받아 가장 싼 것을 고르고,
# 고른 이름을 <데이터폴더>/distill-model.json에 저장한다. 그 이름이 더는 안 통하면 다시 고른다.
# 특정 모델로 못 박고 싶을 때만 값을 넣어라. 값을 넣으면 자동 선택이 그 값을 건드리지 않는다.
# AETHER_REFLECT_MODEL=                       # 예: haiku (비우면 자동 선택)
# AETHER_DISTILL_TIMEOUT_MS=120000            # 배경 작업 1회 상한(ms). 초과하면 중단

# ── 저장소 — SQLite 파일 하나 (세션 일기, 과거 검색 색인, 검색 기록, 공통 오류) ──
# AETHER_DB_PATH=                             # 비우면 <데이터폴더>/aether.sqlite. 백업은 npm run db:backup

# ── Codex / Grok / Ollama (쓰는 것만) ──
# AETHER_CODEX_BIN=                           # codex 실행 파일 경로(기본: PATH 탐색)
# AETHER_CODEX_MODEL=                         # Codex 세션 기본 모델(비우면 계정 기본)
# AETHER_GROK_BIN=                            # grok 실행 파일 경로(기본: PATH 탐색)
# AETHER_GROK_MODEL=                          # Grok 세션 기본 모델
# AETHER_OLLAMA_URL=http://127.0.0.1:11434    # Ollama 서버 주소
# AETHER_OLLAMA_MODEL=                        # Ollama 세션 기본 모델(비우면 목록의 첫 모델)
# AETHER_OLLAMA_CONTEXT_WINDOW=32768          # Ollama 서버 쪽 대화 길이 설정과 같아야 한다
