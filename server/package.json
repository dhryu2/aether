{
  "name": "aether-server",
  "version": "0.0.0",
  "aetherReleaseVersion": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx index.ts",
    "start": "node --env-file-if-exists=.env --import tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run-all.ts",
    "hash:pw": "tsx scripts/hash-password.ts",
    "test:auth": "tsx test/auth_phase3.ts",
    "test:fs": "tsx test/fs_list.ts",
    "test:mutation": "tsx test/phase5_mutation_preview.ts",
    "test:strip": "tsx test/phase5_persist_strip.ts",
    "test:persist": "tsx test/persist_filter.ts",
    "test:lifecycle": "tsx test/phase5_lifecycle.ts",
    "test:restore": "tsx test/phase6_restore.ts",
    "test:session-letter": "AETHER_DATA_DIR=\"$(mktemp -d)\" tsx test/session_letter_search.ts",
    "test:golden": "AETHER_DATA_DIR=\"$(mktemp -d)\" tsx test/normalize_golden.ts",
    "test:wire": "tsx test/wire_events.ts && tsx ../web/test/deriveTurn.test.ts && tsx ../web/test/streamSegments.test.ts",
    "test:wire:live": "tsx test/wire_live.ts",
    "test:boundary": "tsx test/provider_boundary.ts",
    "test:platform-boundary": "tsx test/platform_boundary.ts",
    "test:provider-auth": "tsx test/provider_auth.ts",
    "test:distill-model": "tsx test/distill_model.ts",
    "test:codec": "tsx test/event_codec.ts",
    "test:codex-client": "tsx test/codex_client.ts",
    "test:codex-sanitize": "tsx test/codex_sanitize.ts",
    "test:codex-runtime": "tsx test/codex_runtime.ts",
    "test:codex-auth": "tsx test/codex_auth.ts",
    "test:codex-distill": "tsx test/codex_distill.ts",
    "test:knowledge": "tsx test/knowledge_tools.ts",
    "test:contract": "AETHER_DATA_DIR=\"$(mktemp -d)\" tsx test/provider_contract.ts",
    "test:workspace-desktop": "tsx test/workspace_desktop.ts",
    "test:trust": "AETHER_DATA_DIR=\"$(mktemp -d)\" tsx test/trust_boundary.ts",
    "test:grok-client": "tsx test/grok_client.ts",
    "test:grok-runtime": "tsx test/grok_runtime.ts",
    "test:grok-sanitize": "tsx test/grok_sanitize.ts",
    "test:grok-auth": "tsx test/grok_auth.ts",
    "test:grok-distill": "tsx test/grok_distill.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx db/backup.ts",
    "db:purge-deleted": "node --env-file-if-exists=.env --import tsx scripts/purge-deleted-session-events.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "diff": "^9.0.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
